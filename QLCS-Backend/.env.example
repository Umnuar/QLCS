# Server
PORT=5000
NODE_ENV=development

# Database (Supabase)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# JWT - PHẢI THAY ĐỔI trước khi chạy production
JWT_SECRET="CHANGE_ME_jwt_secret_min_32_chars_long"
JWT_REFRESH_SECRET="CHANGE_ME_jwt_refresh_secret_min_32_chars"

# CCCD Encryption - AES-256-GCM (64 hex chars = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CCCD_HASH_PEPPER="YOUR_CCCD_HASH_PEPPER_KEY_HERE"

# Backup Encryption (optional)
BACKUP_ENCRYPTION_KEY="CHANGE_ME_backup_key_min_32_chars"

# CORS (Hỗ trợ Cloudflare Tunnel & Local dev)
CORS_ORIGIN="https://qlcs.dulieudakha.vn,https://dulieudakha.vn,http://localhost:5173"
